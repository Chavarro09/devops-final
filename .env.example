# Copie este archivo como .env y ajuste los valores:  cp .env.example .env
# El archivo .env NUNCA se sube a GitHub.

# Identificación (aparece en la ruta / de la API)
ESTUDIANTE=estudianteXX

# Puerto publicado en el droplet: 8000 + su número (estudiante07 -> 8007)
API_PORT=80XX

# Base de datos (los usa el contenedor de PostgreSQL y la API)
POSTGRES_DB=tareas
POSTGRES_USER=estudiante
POSTGRES_PASSWORD=cambie_esta_clave

# Conexión desde la API: DB_HOST debe ser el nombre del servicio de la BD en el docker-compose.yml
DB_HOST=db
DB_PORT=5432
